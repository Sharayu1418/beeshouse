# Vercel Postgres (Neon) injects POSTGRES_URL; both names are accepted.
# Use a pooled connection string: serverless opens a lot of short connections.
DATABASE_URL=postgresql://user:PASSWORD@host.neon.tech/dbname?sslmode=require

# Leave it unset to run in memory. Fine for a local game, wiped on restart,
# and the app says so loudly on boot so you never mistake one for the other.
